{
    "manifest_version": 3,
    "name": "Echo",
    "version": "2.1.0",
    "description": "Builder-first comment copilot for LinkedIn, Reddit, and X with configurable AI endpoints.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "alarms",
        "tabs",
        "webRequest"
    ],
    "host_permissions": [
        "*://www.linkedin.com/*",
        "*://*.reddit.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.linkedin.com/*"
            ],
            "js": [
                "lib/html2canvas.min.js",
                "content/platform_router.js",
                "content/reddit_logic.js",
                "content/reddit_driver.js",
                "content/x_logic.js",
                "content/x_driver.js",
                "content/driver.js",
                "content/content.js"
            ],
            "css": [
                "content/content.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.reddit.com/*"
            ],
            "js": [
                "lib/html2canvas.min.js",
                "content/platform_router.js",
                "content/reddit_logic.js",
                "content/reddit_driver.js",
                "content/x_logic.js",
                "content/x_driver.js",
                "content/driver.js",
                "content/content.js"
            ],
            "css": [
                "content/content.css"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "*://*.x.com/*",
                "*://*.twitter.com/*"
            ],
            "js": [
                "lib/html2canvas.min.js",
                "content/platform_router.js",
                "content/x_logic.js",
                "content/x_driver.js",
                "content/driver.js",
                "content/content.js"
            ],
            "css": [
                "content/content.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "dashboard/dashboard.html",
                "dashboard/dashboard.css",
                "dashboard/dashboard.js",
                "lib/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
